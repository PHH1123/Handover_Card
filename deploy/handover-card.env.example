# EC2의 /etc/handover-card.env 로 복사해서 값을 채운다.
#   sudo cp handover-card.env.example /etc/handover-card.env
#   sudo chown $USER:$USER /etc/handover-card.env && sudo chmod 600 /etc/handover-card.env
#
# 소유자를 root로 두면 안 된다. --env-file은 도커 데몬이 아니라 도커 CLI가 읽으므로,
# deploy.sh를 실행하는 사용자가 읽을 수 있어야 한다. 그 사용자는 이미 docker 그룹에 속해
# 사실상 root 권한을 갖고 있으니, 소유자를 옮겨도 실제로 낮아지는 방어선은 없다.
#
# 값을 쓸 때 주의 — 도커의 env-file은 셸이 아니라서 다음이 통하지 않는다:
#   - 등호 주변 공백 (KEY = value)
#   - 따옴표 (KEY="value" 는 따옴표까지 값이 된다)
#   - 값 뒤 인라인 주석 (KEY=value # 설명  → 값이 "value # 설명"이 된다)
#
# 이 파일은 예시일 뿐이므로 실제 값을 적어서 커밋하지 말 것.

# --- DB ---
# RDS를 쓰면 호스트를 RDS 엔드포인트로 바꾼다. serverTimezone=UTC를 빼면 저장된 시각이 흔들린다.
DB_URL=jdbc:mysql://localhost:3306/handover_card?useSSL=true&serverTimezone=UTC
DB_USERNAME=handover
DB_PASSWORD=

# 스키마가 없는 첫 배포에서만 update로 한 번 띄우고, 성공하면 이 줄을 지워 validate로 되돌린다.
# 주석(#)을 지워야 적용된다 — 남아 있으면 도커가 그 줄을 통째로 건너뛴다.
# SPRING_JPA_HIBERNATE_DDL_AUTO=update

# --- 인증 ---
# 32바이트 이상. 예: openssl rand -base64 48
JWT_SECRET=

# --- OpenAI ---
OPENAI_API_KEY=

# --- S3 ---
# 액세스 키는 넣지 않는다. EC2에 IAM Role을 붙이면 SDK 기본 자격증명 체인이 알아서 쓴다.
# 역할을 "만드는 것"과 인스턴스에 "붙이는 것"은 별개다 — deploy/README.md의 IAM 절 참고.
S3_BUCKET=
S3_REGION=ap-northeast-2

# --- 소셜 로그인 ---
# 쓰지 않을 공급자는 줄째로 주석 처리할 것. 빈 값으로 두면
# "Client id must not be empty"로 애플리케이션이 아예 뜨지 않는다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
