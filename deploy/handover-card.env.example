# 서버의 /etc/handover-card.env 로 복사해서 값을 채운다.
#   sudo cp handover-card.env.example /etc/handover-card.env
#   sudo chown $USER:$USER /etc/handover-card.env && sudo chmod 600 /etc/handover-card.env
#
# 소유자를 root로 두면 안 된다. --env-file은 도커 데몬이 아니라 도커 CLI가 읽으므로,
# deploy.sh를 실행하는 사용자가 읽을 수 있어야 한다. 그 사용자는 이미 docker 그룹에 속해
# 사실상 root 권한을 갖고 있으니, 소유자를 옮겨도 실제로 낮아지는 방어선은 없다.
#
# 값을 쓸 때 주의 — 도커의 env-file은 셸이 아니라서 다음이 통하지 않는다:
#   - 등호 주변 공백 (KEY = value)
#   - 따옴표 (KEY="value" 는 따옴표까지 값이 된다)
#   - 값 뒤 인라인 주석 (KEY=value # 설명  → 값이 "value # 설명"이 된다)
#
# 이 파일은 예시일 뿐이므로 실제 값을 적어서 커밋하지 말 것.

# --- DB ---
# 호스트는 RDS 엔드포인트. 콘솔에 같이 보이는 ARN(arn:aws:rds:...)은 접속 주소가 아니다.
# serverTimezone=UTC를 빼면 저장된 시각이 DB 서버 타임존을 따라 흔들린다.
#
# 서버가 AWS 밖에 있으므로 이 연결은 공인망을 지나간다. useSSL=true는 반드시 유지하고,
# RDS 보안 그룹은 이 서버의 공인 IP 하나만 열 것(deploy/README.md 3절).
DB_URL=jdbc:mysql://<rds-endpoint>:3306/handover_card?useSSL=true&serverTimezone=UTC
DB_USERNAME=handover
DB_PASSWORD=

# 스키마가 없는 첫 배포에서만 update로 한 번 띄우고, 성공하면 이 줄을 지워 validate로 되돌린다.
# 주석(#)을 지워야 적용된다 — 남아 있으면 도커가 그 줄을 통째로 건너뛴다.
# SPRING_JPA_HIBERNATE_DDL_AUTO=update

# --- 인증 ---
# 32바이트 이상. 예: openssl rand -base64 48
JWT_SECRET=

# --- OpenAI ---
OPENAI_API_KEY=

# --- S3 ---
# 서버가 AWS 밖(가비아 클라우드)이라 IAM 인스턴스 역할을 쓸 수 없다. 역할은 EC2 메타데이터
# 주소(169.254.169.254)에서 임시 자격증명을 받는 방식인데 그 주소는 AWS 인스턴스 안에서만
# 응답한다. 그래서 IAM "사용자"를 따로 만들어 액세스 키를 발급받아 여기에 넣는다.
#
# 키에는 이 버킷의 PutObject/GetObject/DeleteObject만 주고 그 외 권한은 주지 않는다.
# 발급 절차와 정책 JSON은 deploy/README.md의 S3 절 참고.
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- CORS ---
# 비워 둔다. 프론트와 API를 한 도메인에서 서비스하는 단일 오리진 구성이라 브라우저가
# 교차 출처로 보지 않고, 따라서 CORS 헤더 자체가 필요 없다. 값이 비어 있으면
# CorsConfig가 어떤 요청에도 CORS 헤더를 붙이지 않는다.
#
# 여기에 값을 넣어야 하는 경우는 하나뿐이다 -- 프론트를 로컬(http://localhost:5173 등)에서
# 띄운 채로 이 운영 서버의 API를 직접 부를 때. 다만 그때도 Vite 프록시(server.proxy)를 쓰면
# 브라우저가 개발 서버하고만 통신하므로 열지 않아도 된다. 그쪽을 권한다.
#
# 열게 되더라도 패턴(https://*.도메인)은 쓰지 말 것. 서브도메인 하나만 남에게 넘어가도
# 그대로 통과한다.
CORS_ALLOWED_ORIGINS=

# --- 소셜 로그인 ---
# 쓰지 않을 공급자는 줄째로 주석 처리할 것. 빈 값으로 두면
# "Client id must not be empty"로 애플리케이션이 아예 뜨지 않는다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
